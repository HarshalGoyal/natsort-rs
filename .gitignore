# Build outputs
/target
**/*.rs.bk
Cargo.lock.orig

# Criterion benchmark output (regenerated by `cargo bench`)
/target/criterion

# Fuzzing artefacts (cargo-fuzz writes these under fuzz/)
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# Python artefacts that may appear if a venv (or the parity harness) runs here
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp

# OS
.DS_Store
Thumbs.db

# Coverage tools
proftest/
lcov.info
*.profraw
*.profdata
coverage/